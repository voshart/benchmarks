{
  "name": "voshart-benchmarks",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "start": "eleventy --serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate.cjs",
    "test": "node --test tests/*.test.cjs",
    "summary": "node scripts/summary.cjs",
    "build": "npm run format:check && npm run validate && npm test && eleventy"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "prettier": "3.9.10",
    "prettier-plugin-jinja-template": "2.2.0"
  }
}
