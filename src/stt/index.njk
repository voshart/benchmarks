<script>(function(){try{document.documentElement.dataset.theme=localStorage.getItem('bench-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch(e){}})();</script>
</head><body class="speech-page"><main>
<header class="hero"><div><small class="eyebrow"><a href="/">Voshart / Benchmarks</a> · <a href="/ocr/">OCR</a></small><h1>Speech-to-text benchmarks</h1><p id="speechBenchmarkNote">Lower error and price. Higher speed.</p></div><button class="quiet" id="themeToggle" type="button" aria-label="Toggle light and dark mode">Theme</button></header>
