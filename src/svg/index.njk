---
permalink: /svg/index.html
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{{ svg.title }}</title>
    <meta
      name="description"
      content="Ranked SVG tracer comparisons with published scores, complexity metrics and source differences."
    />
    <link rel="canonical" href="https://bench.voshart.com/svg/" />
    <link rel="stylesheet" href="{{ '/assets/css/benchmark.css' | assetUrl }}" />
    <link rel="stylesheet" href="{{ '/assets/css/svg.css' | assetUrl }}" />
    <script>
      (function () {
        try {
          document.documentElement.dataset.theme =
            localStorage.getItem('bench-theme') ||
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="svg-page">
    <main id="{{ svg.landing.id or 'svg-overview' }}">
      <header class="hero">
        <div>
          <small class="eyebrow"
            ><a href="/">Voshart / Benchmarks</a> · <a href="/ocr/">OCR</a> ·
            <a href="/stt/">Speech</a></small
          >
          <h1>SVG tracer benchmarks</h1>
          <p>Quality, complexity and failures.</p>
        </div>
        <button
          class="quiet"
          id="themeToggle"
          type="button"
          aria-label="Toggle light and dark mode"
        >
          Theme
        </button>
      </header>
      <nav class="svg-nav" aria-label="Comparison groups">
        {% for panel in svg.panels %}
          <a href="#{{ panel.run.id }}" data-svg-link="{{ panel.run.id }}">{{ panel.run.label }}</a>
        {% endfor %}
      </nav>
      <div class="controls svg-controls">
        <select id="svgRun" aria-label="Dataset and execution protocol">
          {% for group in svg.reportingGroups %}
            <optgroup label="{{ group.label }}">
              {% for run in group.runs %}
                <option value="{{ run.id }}" {% if run.id == svg.default_run %}selected{% endif %}>
                  {{ run.label }}
                </option>
              {% endfor %}
            </optgroup>
          {% endfor %}
        </select>
        <input
          id="svgSearch"
          type="search"
          placeholder="Search tracers…"
          aria-label="Search tracers in this group"
        />
        <button type="button" id="svgReset">Reset</button>
      </div>
      <p class="key" id="svgStatus" role="status">
        Ranks stay within each comparison. Missing results stay unranked.
      </p>
      {% for panel in svg.panels %}
        <section
          id="{{ panel.run.id }}"
          class="svg-run"
          data-columns="{{ panel.run.columns.length }}"
          data-svg-run="{{ panel.run.id }}"
          aria-labelledby="heading-{{ panel.run.id }}"
        >
          <h2 id="heading-{{ panel.run.id }}">{{ panel.run.label }}</h2>
          <p class="svg-meta">{{ panel.run.summary }}</p>
          <div
            class="table-scroll"
            tabindex="0"
            role="region"
            aria-label="{{ panel.run.label }} results; scroll horizontally for all metrics"
          >
            <table>
              <caption class="sr-only">
                {{ panel.run.label }}. {{ panel.run.summary }}.
              </caption>
              <thead>
                <tr>
                  {{ panel | svgHead(svg) | safe }}
                </tr>
              </thead>
              <tbody class="svg-ranked-body">
                {{ panel | svgRows(svg) | safe }}
              </tbody>
            </table>
          </div>
          <details
            class="comparison-note svg-unranked"
            {% if not panel.unrankedRows.length %}hidden{% endif %}
          >
            <summary>{{ panel.unrankedRows.length }} without a complete score</summary>
            <p>
              Missing results are not failures. A complete panel is required for a mean and rank.
            </p>
            <div
              class="table-scroll"
              tabindex="0"
              role="region"
              aria-label="Incomplete {{ panel.run.label }} results"
            >
              <table>
                <thead>
                  <tr>
                    {{ panel | svgHead(svg) | safe }}
                  </tr>
                </thead>
                <tbody class="svg-unranked-body">
                  {{ panel | svgUnranked(svg) | safe }}
                </tbody>
              </table>
            </div>
          </details>
          <details class="method">
            <summary>About this benchmark</summary>
            <p>{{ panel.run.method }}</p>
            <p>{{ panel.run.caveat }}</p>
            <p>
              Execution: {{ svg.sources[panel.run.source_id].operator }} ·
              {{ svg.sources[panel.run.source_id].attribution }}.
            </p>
            {% if panel.run.sample_count_note %}
              <p>{{ panel.run.sample_count_note }}</p>
            {% elif panel.run.sample_count == null %}
              <p>
                Exact evaluated count unverified. Reported size:
                {{ panel.run.reported_sample_count or 'unavailable' }}.
              </p>
            {% endif %}
            {% if panel.run.dataset_metadata %}
              <p>
                Dataset inputs: {{ panel.run.dataset_metadata.input_token_mean }} ±
                {{ panel.run.dataset_metadata.input_token_sd }} tokens;
                {{ panel.run.dataset_metadata.primitives }}. These are input statistics, not tracer
                output sizes.
              </p>
            {% endif %}
            <p>
              <a href="{{ svg.sources[panel.run.source_id].url }}">Result source ↗</a> ·
              <a href="{{ svg.sources[panel.run.dataset_source].url }}">Dataset source ↗</a>
            </p>
          </details>
        </section>
      {% endfor %}
      <p class="key">
        ↑ higher · ↓ lower · — unavailable · ⓘ details. Complexity does not affect quality rank.
      </p>
      <p class="svg-difference-note">
        Our font scores differ from StarVector’s table.
        <button class="quiet" type="button" popovertarget="svg-differences">Compare ⓘ</button>
      </p>
      <div id="svg-differences" popover class="rank-note svg-detail">
        <button
          class="rank-note-close"
          type="button"
          popovertarget="svg-differences"
          popovertargetaction="hide"
          aria-label="Close score differences"
        >
          ×
        </button>
        <h3>Where our results differ</h3>
        {{ svg | svgDifferences | safe }}
        <p>
          <a href="#fonts-full-20261104" data-svg-link="fonts-full-20261104"
            >View our full font run →</a
          >
          · <a href="/svg/evidence/protocol-diagnostic.json">Diagnostic data</a>
        </p>
      </div>
      <noscript
        ><p>
          All tables and details work without JavaScript. JavaScript enables selection, search and
          sorting.
        </p></noscript
      >
      <details class="method" id="methodology">
        <summary>Ranking, metrics & sources</summary>
        <p>
          Rank follows the selected benchmark’s quality metric, using every eligible row before
          search. Ties share a rank. The SVG-Bench overview uses the equal mean of all five named
          datasets from the same publication. It is calculated here, not reported by the authors.
          Missing components stay unranked; no local or cross-paper scores fill gaps.
          Dataset-specific configurations are not one universal checkpoint.
        </p>
        <p>
          Paths, segments and tokenizer lengths remain separate measures. Fewer elements do not
          establish better reconstruction. Sorting any column changes display order, not quality
          rank. Published input token statistics are not model output complexity. No shared speed or
          price ranking is inferred.
        </p>
        <p>
          Local font scores use matched resvg renders: 256 px for DINOv2-base FP32, with all
          final-layer tokens averaged and cosine mapped to (cosine + 1) / 2; 1024 px for geometry,
          reported in native pixels. All images are retained. Empty output against visible reference
          gets a 256 px boundary penalty; blank against blank is zero. Conditional nonempty means
          exclude those cases and are labeled in ⓘ.
        </p>
        <p>
          The pilot is contained in the full font run. PolyFit inputs are original rasters without
          vector masters. Sampled topology is not exact vector certification. No local StarVector or
          AutoTrace run is available. Source verification is not independent execution.
        </p>
        <details class="comparison-note">
          <summary>Metric definitions</summary>
          <dl class="svg-definitions">
            {% for id, metric in svg.metrics %}
              <dt>{{ metric.label }}</dt>
              <dd>{{ metric.description }}</dd>
            {% endfor %}
          </dl>
        </details>
        <p>
          <a href="/svg/data.json" download="svg-tracer-results.json">Download data JSON</a> ·
          <a href="/svg/evidence/starvector-models-2025.csv">StarVector table CSV</a> ·
          <a href="/svg/evidence/starvector-provenance.json">StarVector provenance</a> ·
          <a href="/svg/evidence/published-tables-2025.json">Other published tables</a> ·
          <a href="/svg/evidence/full-fonts-summary.json">Full-run summary</a> ·
          <a href="/svg/evidence/pilot-summary.json">Pilot summary</a> ·
          <a href="/svg/evidence/provenance.json">Local provenance</a>
        </p>
        <details class="comparison-note">
          <summary>All sources</summary>
          <div class="source-grid">
            {% for id, source in svg.sources %}
              <p>
                <a href="{{ source.url }}" target="_blank" rel="noreferrer">{{ source.title }}</a
                ><br /><small
                  >{{ source.operator }} · {{ source.attribution }}. {{ source.note }}</small
                >
              </p>
            {% endfor %}
          </div>
        </details>
      </details>
      <p class="key svg-affiliation">{{ svg.affiliation }}</p>
      <footer>
        Evidence snapshot {{ svg.snapshot_date }} ·
        <a href="https://github.com/voshart/benchmarks/tree/main/data/svg"
          >Source data & methodology</a
        >
        · <a href="/">All benchmarks</a>
      </footer>
    </main>
    <script defer src="{{ '/assets/js/svg-comparison.js' | assetUrl }}"></script>
    <script defer src="{{ '/assets/js/svg-page.js' | assetUrl }}"></script>
  </body>
</html>
